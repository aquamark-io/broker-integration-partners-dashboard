<%- include('partials/head', { title: 'Dashboard' }) %>
<body>
  <%- include('partials/nav') %>

  <main class="main">
    <!-- Partner Info -->
    <section class="section">
      <div class="partner-card">
        <div class="partner-card-label">Integration Partner</div>
        <div class="partner-card-name"><%= partner.company_name %></div>
      </div>
    </section>

    <!-- API Key Section -->
    <section class="section">
      <div class="section-header">
        <h2>API Key</h2>
      </div>
      <div class="api-key-card">
        <p class="api-key-docs"><a href="https://www.aquamark.io/broker-api" target="_blank" rel="noopener">API Documentation →</a></p>
        <div class="api-key-display">
          <code class="api-key-text"><%- apiKey %></code>
          <div class="api-key-actions">
            <button id="copyKeyBtn" class="btn btn-sm btn-ghost">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              Copy
            </button>
          </div>
        </div>
        <p class="api-key-hint">This is a universal API key. Individual brokers are provisioned via the <code class="code-green">user_email</code> parameter in each request.</p>
      </div>
    </section>

    <!-- Per User Pricing -->
    <section class="section">
      <div class="section-header">
        <h2>Per User Pricing</h2>
      </div>
      <div class="pricing-card-simple">
        <div class="pricing-rows">
          <div class="pricing-row">
            <span class="pricing-row-label">Up to 5,000 files/mo</span>
            <span class="pricing-row-value">$299</span>
            <a href="https://buy.stripe.com/3cI00k1w2gOna694P68ww08" target="_blank" rel="noopener" class="btn btn-sm btn-green">Subscribe User</a>
          </div>
          <div class="pricing-row">
            <span class="pricing-row-label">Up to 25,000 files/mo</span>
            <span class="pricing-row-value">$499</span>
            <a href="https://buy.stripe.com/14A9AUb6C8hR0vz81i8ww09" target="_blank" rel="noopener" class="btn btn-sm btn-green">Subscribe User</a>
          </div>
          <div class="pricing-row pricing-row-last">
            <span class="pricing-row-label">Above 25,000 files</span>
            <span class="pricing-row-value">Custom</span>
            <a href="mailto:info@aquamark.io" class="btn btn-sm btn-ghost">Contact Us</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Broker Users -->
    <section class="section">
      <div class="section-header">
        <h2>Broker Users</h2>
        <span class="badge"><%= activeCount %> active</span>
        <button id="addUserBtn" class="btn btn-sm btn-primary" style="margin-left: auto;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          Add User
        </button>
      </div>
      <p class="contact-note" style="margin-bottom: 16px;">To modify or deactivate a user, contact <a href="mailto:info@aquamark.io">info@aquamark.io</a></p>

      <% if (brokerUsers.length === 0) { %>
        <div class="empty-state">
          <p>No broker users yet. Add your first user to get started.</p>
        </div>
      <% } else { %>
        <div class="users-table-wrap">
          <table class="users-table">
            <thead>
              <tr>
                <th>Company</th>
                <th>Email</th>
                <th>Logo</th>
                <th style="text-align: center;">Files This Month</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% brokerUsers.forEach(user => { %>
                <tr class="<%= user.is_active ? '' : 'row-inactive' %>">
                  <td class="cell-company"><%= user.company_name %></td>
                  <td class="cell-email"><%= user.user_email %></td>
                  <td class="cell-logo">
                    <img class="logo-thumb-img" id="logo-<%= user.user_email.replace(/[^a-zA-Z0-9]/g, '_') %>" src="" alt="" style="display:none;" />
                  </td>
                  <td class="cell-usage">
                    <% const usage = userUsageMap[user.user_email]; %>
                    <% if (usage) { %>
                      <span class="usage-pill"><%= usage.files %></span>
                    <% } else { %>
                      <span class="usage-pill usage-none">—</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="status-dot <%= user.is_active ? 'status-active' : 'status-inactive' %>">
                      <%= user.is_active ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <!-- Add User Modal -->
  <div id="addModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Add Broker User</h3>
        <button class="modal-close close-add-modal">&times;</button>
      </div>
      <form id="addForm">
        <div class="form-group">
          <label class="form-label">Email</label>
          <input type="email" name="user_email" required class="form-input" placeholder="broker@company.com" />
        </div>
        <div class="form-group">
          <label class="form-label">Company Name</label>
          <input type="text" name="company_name" required class="form-input" placeholder="Company Inc." />
        </div>
        <div class="form-group">
          <label class="form-label">Logo <span class="form-hint">(optional — PNG, JPG, max 5MB)</span></label>
          <input type="file" name="logo" accept="image/*" class="form-input-file" />
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-ghost close-add-modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="addSubmitBtn">Add User</button>
        </div>
        <div id="addFormMessage" class="form-message"></div>
      </form>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {

      // --- Copy API Key ---
      var copyBtn = document.getElementById('copyKeyBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function() {
          var key = '<%- apiKey %>';
          var ta = document.createElement('textarea');
          ta.value = key;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          copyBtn.textContent = '✓ Copied';
          setTimeout(function() {
            copyBtn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy';
          }, 2000);
        });
      }

      // --- Modal helpers ---
      function openModal(id) { document.getElementById(id).classList.add('active'); }
      function closeModal(id) { document.getElementById(id).classList.remove('active'); }

      // --- Add User button ---
      var addBtn = document.getElementById('addUserBtn');
      if (addBtn) {
        addBtn.addEventListener('click', function() {
          document.getElementById('addForm').reset();
          document.getElementById('addFormMessage').textContent = '';
          openModal('addModal');
        });
      }

      // --- Close modal buttons ---
      document.querySelectorAll('.close-add-modal').forEach(function(el) {
        el.addEventListener('click', function() { closeModal('addModal'); });
      });

      // --- Click backdrop to close ---
      document.getElementById('addModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal('addModal');
      });

      // --- Add User form submit ---
      document.getElementById('addForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var form = this;
        var msg = document.getElementById('addFormMessage');
        var btn = document.getElementById('addSubmitBtn');
        btn.disabled = true;
        btn.textContent = 'Adding...';
        msg.textContent = '';
        msg.className = 'form-message';

        var formData = new FormData(form);
        fetch('/users/add', { method: 'POST', body: formData })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) {
              msg.textContent = 'User created! Reloading...';
              msg.classList.add('form-message-success');
              setTimeout(function() { location.reload(); }, 1000);
            } else {
              msg.textContent = data.error || 'Failed to add user';
              msg.classList.add('form-message-error');
              btn.disabled = false;
              btn.textContent = 'Add User';
            }
          })
          .catch(function() {
            msg.textContent = 'Network error. Please try again.';
            msg.classList.add('form-message-error');
            btn.disabled = false;
            btn.textContent = 'Add User';
          });
      });

      // --- Load logo thumbnails ---
      var emails = <%- JSON.stringify(brokerUsers.map(u => u.user_email)) %>;
      emails.forEach(function(email) {
        var id = 'logo-' + email.replace(/[^a-zA-Z0-9]/g, '_');
        var el = document.getElementById(id);
        if (!el) return;
        fetch('/users/logo/' + encodeURIComponent(email))
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.url) {
              el.src = data.url;
              el.style.display = '';
            }
          })
          .catch(function() {});
      });

    });
  </script>
</body>
</html>

<%
  function monthName(m) {
    return ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][m] || '';
  }
%>
